# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.mcp.json

# claude code local settings (may contain secrets)
.claude/

# local working docs (Apple review files — keep out of the repo)
Apple.pdf
Apple.docx
MAFS_Apple_Setup_For_Client.pdf
*.docx
~$*

# Apple signing secrets — NEVER commit (private keys, provisioning profile, passwords)
apple/
*.p8
*.p12
*.mobileprovision

# Database dumps from scripts/backup-db.mjs. These contain user emails, session
# tokens and OAuth account rows. The script writes outside the repo by default;
# this is the safety net for when an output dir is passed explicitly.
/backups/
/mafs-backup-*/
*.jsonl
