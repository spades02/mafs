# ─────────────────────────────────────────────────────────────────────────────
# Shutdown switch
#
# Set to 1 to take MAFS fully offline. proxy.ts then answers every request with
# a static 503 maintenance page before touching the database, and the LLM and
# email layers hard-refuse. This is what makes it safe to run the deployment
# while the Supabase project is paused — see lib/shutdown.ts.
#
# Read into the middleware bundle at BUILD time: changing it in the Vercel
# dashboard requires a redeploy to take effect.
#
# Leave unset (or 0) for normal operation.
# ─────────────────────────────────────────────────────────────────────────────
MAFS_OFFLINE=

# ─────────────────────────────────────────────────────────────────────────────
# Sign in with Apple (App Store Guideline 4.8)
#
# The Apple social provider in app/lib/auth/auth.ts activates automatically once
# these are present. iOS uses the NATIVE flow (idToken validated against the app
# bundle id); web uses the Services ID + a generated client secret JWT.
#
# The client generates these in the Apple Developer portal — see
# CLIENT_APP_STORE_GUIDE.md → Step 3.
# ─────────────────────────────────────────────────────────────────────────────

# The app's bundle identifier. Used to validate the native iOS idToken audience.
APPLE_APP_BUNDLE_IDENTIFIER=ai.mafs.app
# Same value, exposed to the client so the native Sign in with Apple button can
# pass it to the plugin (components/apple-login-button.tsx).
NEXT_PUBLIC_APPLE_APP_BUNDLE_IDENTIFIER=ai.mafs.app

# Services ID created in the Apple Developer portal (e.g. ai.mafs.signin).
# Required for the web Apple OAuth flow; also added to the accepted token audience.
APPLE_CLIENT_ID=

# Apple Team ID (10 chars, e.g. 6K2AZWR26Y).
APPLE_TEAM_ID=

# Key ID (10 chars) of the "Sign in with Apple" key (.p8) created in the portal.
APPLE_KEY_ID=

# Contents of the downloaded .p8 private key. Paste the full key including the
# BEGIN/END lines. In a single env var, use \n for line breaks, e.g.
# "-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# OPTIONAL — only needed for WEB Apple sign-in (not the native iOS flow).
# A client-secret JWT signed with the .p8 key (TEAM_ID + KEY_ID + PRIVATE_KEY).
# Leave blank if you only support Apple sign-in on iOS.
APPLE_CLIENT_SECRET=
